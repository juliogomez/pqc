{#
  The two parts of the EAP-TLS stack that are modelled.

  /native/mka/policy[name]/macsec-cipher-suite
  /native/dot1x/credentials[profile-name]/username
  /native/dot1x/credentials[profile-name]/pki-trustpoint

  The MKA policy is the same shape as the PSK one but a different object, because the
  two paths are meant to be built and torn down independently.

  It is also where the one genuinely confusing asymmetry in these labs lives. This
  policy sets GCM-AES-256 on the wire, and it works. But the MKA key-wrap cipher on
  this path is stuck at AES-128-CMAC, because the CAK is derived from a 128-bit
  EAP-TLS MSK, while the PSK path gets AES-256-CMAC from a 64-hex-character key you
  typed in. Same GCM-AES-256 data plane, different key-wrap strength. That is expected
  and logged; it is not a misconfiguration to chase.

  dot1x credentials carries the identity EAP sends and the trustpoint it signs with.
  The username here must equal the certificate CN and the "username ... aaa attribute
  list" entry, or the port authenticates and then fails to get the must-secure policy.
-#}
{% set op = ' nc:operation="remove"' if state == 'absent' else '' %}
<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0"
        xmlns:nc="urn:ietf:params:xml:ns:netconf:base:1.0">
  <native xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-native">
    <mka>
      <policy xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-mka"{{ op }}>
        <name>{{ macsec_names.eaptls_mka_policy }}</name>
{% if state == 'present' %}
        <macsec-cipher-suite>{{ macsec_cipher_suite }}</macsec-cipher-suite>
{% endif %}
      </policy>
    </mka>
    <dot1x>
      <credentials xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-dot1x"{{ op }}>
        <profile-name>{{ macsec_names.dot1x_credentials }}</profile-name>
{% if state == 'present' %}
        <username>{{ my_macsec_identity }}</username>
        <pki-trustpoint>{{ pki_names.eaptls_trustpoint }}</pki-trustpoint>
{% endif %}
      </credentials>
    </dot1x>
  </native>
</config>
