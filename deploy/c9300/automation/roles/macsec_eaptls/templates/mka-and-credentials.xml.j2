{# MKA policy and dot1x credentials for EAP-TLS.

  The MKA policy is the same shape as the PSK one but a different object, because
  the two paths are meant to be built and torn down independently.

  dot1x credentials carries the identity EAP sends and the trustpoint it signs with.
  The username does NOT have to match the certificate CN, but it must match the
  "username ... aaa attribute list" entry the PEER creates for us, or the port
  authenticates and then fails to get the must-secure policy. aaa-stack.yml builds
  an entry for both ends of the hop for exactly that reason.

  The trustpoint is the device's shipped TP-self-signed-<serial>, discovered at run
  time in cert-identity.yml, not a name from crypto.yml.
-#}
{% set op = ' nc:operation="remove"' if state == 'absent' else '' %}
<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0"
        xmlns:nc="urn:ietf:params:xml:ns:netconf:base:1.0">
  <native xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-native">
    <mka>
      <policy xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-mka"{{ op }}>
        <name>{{ macsec_names.eaptls_mka_policy }}</name>
{% if state == 'present' %}
        <macsec-cipher-suite>{{ macsec_cipher_suite }}</macsec-cipher-suite>
{% endif %}
      </policy>
    </mka>
    <dot1x>
      <credentials xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-dot1x"{{ op }}>
        <profile-name>{{ my_macsec_dot1x_credentials }}</profile-name>
{% if state == 'present' %}
        <username>{{ my_macsec_identity }}</username>
        <pki-trustpoint>{{ macsec_eaptls_identity_trustpoint }}</pki-trustpoint>
{% endif %}
      </credentials>
    </dot1x>
  </native>
</config>
