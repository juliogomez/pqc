{#
  One IKEv2 profile for the single peer.

  /native/crypto/ikev2/profile[name]/match/identity/remote/address/ipv4[ipv4-address]
  /native/crypto/ikev2/profile[name]/identity/local/address
  /native/crypto/ikev2/profile[name]/authentication/{local,remote}
  /native/crypto/ikev2/profile[name]/keyring/local/name
  /native/crypto/ikev2/profile[name]/dpd/{interval,retry,query}

  C8000 loops here because hub-spoke needs one profile per peer. C9300 has a
  single peer: one profile, one match, one keyring reference.

  authentication is a YANG choice, so switching to ML-DSA later is not an
  addition, it is a replacement of the case.
-#}
{% set op = ' nc:operation="remove"' if state == 'absent' else '' %}
<config xmlns="urn:ietf:params:xml:ns:netconf:base:1.0"
        xmlns:nc="urn:ietf:params:xml:ns:netconf:base:1.0">
  <native xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-native">
    <crypto>
      <ikev2 xmlns="http://cisco.com/ns/yang/Cisco-IOS-XE-crypto">
        <profile{{ op }}>
          <name>{{ crypto_names.ike_profile }}</name>
{% if state == 'present' %}
          <match>
            <identity>
              <remote>
                <address>
                  <ipv4>
                    <ipv4-address>{{ my_ipsec.peer_loopback }}</ipv4-address>
                    <ipv4-mask>{{ ike_peer_match_mask }}</ipv4-mask>
                  </ipv4>
                </address>
              </remote>
            </identity>
          </match>
          <identity>
            <local>
              <address>{{ my_ipsec.loopback_address }}</address>
            </local>
          </identity>
          <authentication>
            <local>
              <pre-share/>
            </local>
            <remote>
              <pre-share/>
            </remote>
          </authentication>
          <keyring>
            <local>
              <name>{{ crypto_names.ike_keyring }}</name>
            </local>
          </keyring>
          <dpd>
            <interval>{{ ike_dpd_interval }}</interval>
            <retry>{{ ike_dpd_retry }}</retry>
            <query>{{ ike_dpd_query }}</query>
          </dpd>
{% endif %}
        </profile>
      </ikev2>
    </crypto>
  </native>
</config>
