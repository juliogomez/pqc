# Superseded original key-exchange writeup, kept locally but not published
README.legacy.md

# Presenter-only material (slide deck build tooling, speaker notes, runbook) and
# the demo notebook — not part of the published two-stage journey
presentation/
notebook/

# Packet captures generated during lab exercises
*.pcap
*.pcapng

# --- Stage 1: learn (container labs) ---

# Generated lab credentials (CA + leaf keys/certs) for the IKEv2 mutual-auth lab.
# Never commit private keys; these are produced at runtime by gen-certs.sh.
learn/ipsec/authentication/config/*/private/
learn/ipsec/authentication/config/*/x509/
learn/ipsec/authentication/config/*/x509ca/

# Generated lab credentials for the TLS authentication lab (CA + server/client
# keys/certs), produced at runtime by gen-certs.sh. Never commit private keys.
learn/tls/authentication/config/*/*.crt
learn/tls/authentication/config/*/*.key

# Generated lab credentials for the MACsec EAP-TLS lab (CA + server/client
# certs and keys), produced at runtime by gen-certs.sh into each role's config
# dir. The .conf and eap_user files are tracked; only the crypto material isn't.
learn/macsec/config/*/*.crt
learn/macsec/config/*/*.key

# Generated lab credentials for the SSH lab (host key + user key + the derived
# authorized_keys / known_hosts), produced at runtime by gen-keys.sh into each
# role's config dir. The *_config files are tracked; only the key material isn't.
learn/ssh/config/server/ssh_host_key
learn/ssh/config/server/ssh_host_key.pub
learn/ssh/config/server/authorized_keys
learn/ssh/config/client/id_key
learn/ssh/config/client/id_key.pub
learn/ssh/config/client/known_hosts

# Python bytecode cache from the module-lattices lab scripts
__pycache__/
*.pyc

# --- Stage 2: deploy (real hardware) ---

# ML-DSA PKI for the IOS XE IKEv2 authentication exercises: root CAs, per-router
# identity certs and the PKCS#12 bundles imported to the routers. Produced at
# runtime by gen-mldsa-certs.sh. The bundles carry unencrypted private keys.
deploy/ios-xe/mldsa-certs/mldsa-pki/

# Belt and braces for the same material: gen-mldsa-certs.sh honours OUT=, so key
# and bundle files can land anywhere under deploy/. Never commit either.
deploy/**/*.p12
deploy/**/*.key
deploy/**/*.srl

# Workstation-side ML-DSA certificate authority used by roles/ipsec_pq_mldsa:
# the CA private key, its self-signed certificate, the per-router CSRs pulled off
# the routers and the identity certificates issued back to them, plus the small
# state files that record what the role changed so teardown can undo exactly that.
# Created at runtime, never committed. The CA private key lives in here.
deploy/ios-xe/automation/.lab-ca/

# Ansible lab credentials for the IOS XE automation layer: management addresses,
# device login, the IKEv2 pre-shared key, the RFC 8784 PPK, the MACsec CAK and the
# local CA passphrase. Copy lab.yml.example to lab.yml and fill it in; the example
# is tracked, the real file never is.
deploy/ios-xe/automation/group_vars/all/lab.yml

# Local Python virtualenvs for the Ansible control node (never commit).
deploy/ios-xe/automation/venv/
deploy/ios-xe/automation/.venv/

# Editor / OS cruft
.cursor/
.DS_Store
*.swp
*~
.idea/
.vscode/
